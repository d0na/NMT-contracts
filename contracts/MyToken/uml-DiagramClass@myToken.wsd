MyTokenMutableAsset --[#DarkGoldenRod]|> MutableAsset : extends

struct  MyTokenDescriptor {
    address attrAddress;
    uint256 attrUint
    bool attrBool;
}


MyTokenDescriptor .. MyTokenMutableAsset 
note on link: MyTokenDescriptor definition

